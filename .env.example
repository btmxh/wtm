# Copy to .env and fill in. Loaded by every pnpm script via --env-file=.env.

# YouTube Data API v3 key - used by import/collect to resolve channels and fetch uploads.
YOUTUBE_API_KEY=

# TypeSafe System One API key - used by the autotag job to judge tag prompts.
TYPESAFE_API_KEY=

# Server port for `pnpm dev` (default 4173).
# PORT=4173
